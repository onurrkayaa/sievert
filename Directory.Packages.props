<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!--
    Paket surumleri tek yerde. Sebep olcumler: bir sayinin hangi surumle uretildigi
    repoda tek bir dosyadan okunabilmeli (ADR 0012). Surumler csproj'lere dagilmis
    olsaydi, bir projede 10.0.4 digerinde 10.0.12 kalabilir ve bunu kimse fark etmezdi -
    bir kez oldu zaten, EF Core ile Design paketi ayrisip derlemeyi kirdi.
  -->
  <ItemGroup>
    <PackageVersion Include="LibGit2Sharp" Version="0.32.0" />
    <!-- 10.0.12: daha eski 10.0.x surumleri Microsoft.OpenApi 2.0.0 cekiyor ve o
         surumde bilinen bir guvenlik acigi var (GHSA-v5pm-xwqc-g5wc). -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.4" />
    <PackageVersion Include="Microsoft.ML" Version="5.0.0" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup Label="Testler">
    <!--
      bUnit: Blazor bileseni test icin gercekten isleniyor.

      Neden gerekli: panelin en kritik iddialarinin hepsi *ciktida* - "yuzde isareti yok",
      "zorunlu uyarilar gorunuyor", "kismi sonuc tam sonuc gibi gorunmuyor". Bunlari
      sinif duzeyinde sinamak, gosterilen seyi degil hesaplanan seyi sinamak olurdu.
      Gercek bir kusur da tam buradan cikti: katki cubugunun genisligi kultura bagli
      bicimlenince "width:67,8%" yaziliyordu ve tarayici bunu yok sayip cubugu tam
      dolduruyordu.
    -->
    <PackageVersion Include="bunit" Version="2.10.3" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.15.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

</Project>
