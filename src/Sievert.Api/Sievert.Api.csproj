<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <!--
    Adim 3'te Sievert.Analysis referansi eklendi: static-scan arka plan isi CLI ile ayni
    tarama servisini cagiriyor. Ayri bir surec baslatmak istemedim, o zaman API'nin
    sonucu baska bir programin cikti bicimini ayristirmaya baglanirdi.

    Adim 3b'de Sievert.Mining referansi eklendi ama yalnizca WorktreeState icin: static
    tarama hangi HEAD'i ve hangi calisma agacini taradigini kaydediyor. Klonlama, tarih
    madenciligi ve SZZ hala API'den cagrilmiyor; commit risk cevabindaki statik bulgu
    bolumu yine "not-run" (ADR 0023).
  -->

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />

    <!-- PDF raporu. Lisans karari: docs/urun/pdf-kutuphanesi-ve-lisans.md -->
    <PackageReference Include="QuestPDF" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sievert.Analysis\Sievert.Analysis.csproj" />
    <ProjectReference Include="..\Sievert.Contracts\Sievert.Contracts.csproj" />
    <ProjectReference Include="..\Sievert.Data\Sievert.Data.csproj" />
    <ProjectReference Include="..\Sievert.Mining\Sievert.Mining.csproj" />
    <ProjectReference Include="..\Sievert.Modeling\Sievert.Modeling.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sievert.Tests" />
  </ItemGroup>

</Project>
