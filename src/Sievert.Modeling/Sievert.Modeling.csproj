<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <!--
    Bilerek bagimsiz: Sievert.Data'ya, Sievert.Mining'e ya da PostgreSQL'e referans yok.
    Bu proje yalnizca dondurulmus dosyayi okuyor. Veritabanina baglansaydi bir modelin
    hangi veriyle egitildigi o gunku veritabaninin haline baglanirdi; anlik goruntunun
    varlik sebebi tam olarak bunu engellemek (docs/olcumler/asama5-veri-kumesi.md).

    CSV okuma framework'un kendisiyle yazildi; tek ihtiyac tirnaklama kurallari ve onlar
    RFC 4180'de birkac satirlik is.

    Tek paket Microsoft.ML: Adim 3'te lojistik regresyon buraya girdi. Surum
    Directory.Packages.props icinde sabit (ADR 0018).
  -->

  <ItemGroup>
    <PackageReference Include="Microsoft.ML" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sievert.Tests" />
  </ItemGroup>

</Project>
