@implements IDisposable
@inject SievertApiClient Api
@inject NavigationManager Navigation

@*
    API su an konusuyor mu.

    Uc durum var ve ucu de farkli: hazir, kismi hazir (API ayakta ama veritabani ya da
    model hazir degil), erisilemiyor. Ikisini birlestirmek "calisiyor ama hicbir sey
    gostermiyor" durumunu aciklanamaz hale getirirdi.
*@
<div class="card raised" aria-live="polite">
    <p class="stat-label">API durumu</p>
    <p class="row" style="margin-top:var(--space-2)">
        <span class="pill @tone">@label</span>
    </p>
    @if (detail is not null)
    {
        <p class="stat-note">@detail</p>
    }
</div>

@code {
    private readonly CancellationTokenSource closing = new();

    private string label = "Bakiliyor";
    private string tone = "tone-idle";
    private string? detail;

    protected override async Task OnInitializedAsync()
    {
        // Her gezinmede yeniden soruluyor. Tek sefer sorsaydik API bir sure sonra geri
        // geldiginde rozet hala "Erisilemiyor" der ve kullanici duzelen bir seyi bozuk
        // sanardi.
        Navigation.LocationChanged += OnLocationChanged;

        await CheckAsync();
    }

    private async Task CheckAsync()
    {
        ApiResult<HealthResponse> health = await Api.HealthAsync(closing.Token);

        if (!health.IsSuccess || health.Value is null)
        {
            (label, tone, detail) = ("Erisilemiyor", "tone-danger", health.Detail);

            return;
        }

        bool databaseReady = health.Value.Database.Reachable && health.Value.Database.MigrationsApplied;

        // NotLoaded bir sorun DEGIL: model tembel yukleniyor ve ilk skorlamaya kadar
        // diskten okunmuyor. Sorun olan iki durum var - ozet tutmuyor ya da yuklenemedi.
        bool modelsUsable = health.Value.Models.All(model => model.Status is "Ready" or "NotLoaded");

        (label, tone, detail) = databaseReady && modelsUsable
            ? ("Hazir", "tone-done", null)
            : ("Kismi hazir", "tone-warning", databaseReady
                ? "Bir model profili kullanilamiyor."
                : "Veritabani hazir degil.");
    }

    /// <summary>
    /// Gezinme olayi senkron; kontrol ise bir HTTP cagrisi.
    ///
    /// <c>async void</c> YAZMIYORUZ: oradan cikan bir istisna yakalanamaz ve sureci
    /// dusurur. Gorev acikca baslatiliyor ve icinde yakalaniyor.
    /// </summary>
    private void OnLocationChanged(object? sender, LocationChangedEventArgs args) => _ = RefreshAsync();

    private async Task RefreshAsync()
    {
        if (closing.IsCancellationRequested)
        {
            return;
        }

        try
        {
            await CheckAsync();
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException)
        {
            // Bilesen birakildi; sorun degil.
        }
        catch (ObjectDisposedException)
        {
            // Devre kapandi.
        }
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        closing.Cancel();
        closing.Dispose();
    }
}
