@page "/repositories/{RepositoryId:int}"
@implements IDisposable
@inject SievertApiClient Api
@inject IPageState State
@inject NavigationManager Navigation

<PageTitle>@(detail?.Repository.Name ?? "Depo") - Sievert</PageTitle>

@if (loading)
{
    <Loading Message="Depo yukleniyor..." />
}
else if (failure is not null)
{
    <ProblemView Result="failure" OnRetry="LoadAsync" />
}
else if (detail is not null)
{
    <PageHeader Title="@detail.Repository.Name" Lead="@detail.Repository.RepositoryIdentity">
        <Actions>
            <button class="btn primary"
                    type="button"
                    disabled="@(busy is not null || Active("static-scan") is not null)"
                    @onclick="@(() => StartAsync("static-scan"))">
                @(busy == "static-scan" ? "Baslatiliyor..." : "Statik tarama baslat")
            </button>

            <button class="btn primary"
                    type="button"
                    disabled="@(busy is not null || detail.ModelProfile is null || Active("risk-score-all") is not null)"
                    @onclick="@(() => StartAsync("risk-score-all"))">
                @(busy == "risk-score-all" ? "Baslatiliyor..." : "Tum commit'leri skorla")
            </button>
        </Actions>
    </PageHeader>

    @if (startProblem is not null)
    {
        <ProblemView Result="startProblem" />
    }

    @foreach (JobSummary running in ActiveJobs)
    {
        <div class="notice info" role="status">
            <p>
                @Display.Kind(running.Kind) isi su an @Display.Status(running.Status).
                <a href="analyses/@running.Id">Ise git</a>
            </p>
        </div>
    }

    @if (conflictUrl is not null)
    {
        <div class="notice warning" role="status">
            <h3>Bu depo icin zaten calisan bir is var</h3>
            <p>Yeni bir is acilmadi. <a href="@PanelLink(conflictUrl)">Duran ise git</a></p>
        </div>
    }

    <div class="cards">
        <div class="card">
            <p class="stat-label">Commit</p>
            <p class="stat-value">@Display.Count(detail.CommitCount)</p>
            <p class="stat-note">olcusu hesaplanan @Display.Count(detail.CommitsWithMetrics)</p>
        </div>
        <div class="card">
            <p class="stat-label">SZZ etiketi</p>
            <p class="stat-value">@Display.Count(detail.BugIntroducingCount)</p>
            <p class="stat-note">@Display.Count(detail.BugIntroducingCount) / @Display.Count(detail.CommitCount) commit</p>
        </div>
        <div class="card">
            <p class="stat-label">Bot commit'i</p>
            <p class="stat-value">@Display.Count(detail.BotCount)</p>
            <p class="stat-note">ad kalibiyla isaretlendi</p>
        </div>
        <div class="card">
            <p class="stat-label">Model profili</p>
            <p class="stat-value" style="font-size:1.1rem">
                @if (detail.ModelProfile is string profile)
                {
                    <span class="pill tone-done">@profile</span>
                }
                else
                {
                    <span class="pill tone-warning">Yok</span>
                }
            </p>
            <p class="stat-note">kalibre edilmedi</p>
        </div>
    </div>

    @if (detail.CoverageNotes.Count > 0)
    {
        <div class="section stack-tight">
            @foreach (string note in detail.CoverageNotes)
            {
                <div class="notice warning"><p>@note</p></div>
            }
        </div>
    }

    <nav class="tabs section" aria-label="Depo bolumleri">
        @foreach ((string key, string label) in Tabs)
        {
            <button type="button"
                    class="tab @(key == CurrentTab ? "tab-open" : string.Empty)"
                    aria-current="@(key == CurrentTab ? "page" : null)"
                    @onclick="() => Go(tab: key)">@label</button>
        }
    </nav>

    @if (CurrentTab == "dosyalar")
    {
        <FileActivitySection RepositoryId="RepositoryId"
                             Jobs="RiskJobs"
                             Scans="ScanJobs"
                             JobId="SelectedJob"
                             Window="SelectedWindow"
                             Limit="SelectedLimit"
                             Sort="@SelectedSort"
                             Overlay="Overlay"
                             JobChanged="value => Go(job: value)"
                             WindowChanged="value => Go(window: value)"
                             LimitChanged="value => Go(limit: value)"
                             SortChanged="value => Go(sort: value)"
                             OverlayChanged="value => Go(overlay: value, clearOverlay: value is null)" />
    }
    else if (CurrentTab == "rapor")
    {
        <ReportForm RepositoryId="RepositoryId" Jobs="RiskJobs" Scans="ScanJobs" />
    }
    else if (CurrentTab == "zaman")
    {
        <TimelineSection RepositoryId="RepositoryId"
                         Jobs="RiskJobs"
                         JobId="SelectedJob"
                         Count="SelectedCount"
                         JobChanged="value => Go(job: value)"
                         CountChanged="value => Go(count: value)" />
    }

    <div class="section" hidden="@(CurrentTab is not ("genel" or "analizler"))">
        <h2>Bu deponun isleri</h2>

        @if (jobs is null || jobs.Count == 0)
        {
            <EmptyState Title="Bu depo icin henuz is acilmadi" />
        }
        else
        {
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th scope="col">Tur</th>
                            <th scope="col">Durum</th>
                            <th scope="col" class="num">Sonuc</th>
                            <th scope="col">Istek</th>
                            <th scope="col"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (JobSummary job in jobs.Take(5))
                        {
                            <tr>
                                <td>@Display.Kind(job.Kind)</td>
                                <td><span class="pill @Display.StatusTone(job.Status)">@Display.Status(job.Status)</span></td>
                                <td class="num">@Display.Count(job.ResultCount)@(job.IsResultComplete ? string.Empty : " (kismi)")</td>
                                <td>@Display.Moment(job.RequestedAtUtc)</td>
                                <td><a href="analyses/@job.Id">Ayrinti</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <div class="section" hidden="@(CurrentTab is not ("genel" or "commitler"))">
        <h2>Commit'ler</h2>

        <div class="row" style="margin-bottom:var(--space-3)">
            <label class="field">
                Sira
                <select value="@order" @onchange="@(args => Apply(() => order = args.Value?.ToString() ?? "newest"))">
                    <option value="newest" selected="@(order == "newest")">En yeni once</option>
                    <option value="oldest" selected="@(order == "oldest")">En eski once</option>
                </select>
            </label>

            <label class="field">
                Duzeltme commit'i
                <select value="@Text(isFix)" @onchange="@(args => Apply(() => isFix = Flag(args)))">
                    <option value="">Hepsi</option>
                    <option value="true">Yalniz duzeltmeler</option>
                    <option value="false">Duzeltme olmayanlar</option>
                </select>
            </label>

            <label class="field">
                SZZ etiketi
                <select value="@Text(isBugIntroducing)" @onchange="@(args => Apply(() => isBugIntroducing = Flag(args)))">
                    <option value="">Hepsi</option>
                    <option value="true">Etiketliler</option>
                    <option value="false">Etiketsizler</option>
                </select>
            </label>

            <label class="field">
                Bot
                <select value="@Text(isBot)" @onchange="@(args => Apply(() => isBot = Flag(args)))">
                    <option value="">Hepsi</option>
                    <option value="true">Yalniz bot</option>
                    <option value="false">Bot olmayanlar</option>
                </select>
            </label>
        </div>

        @if (commits is null)
        {
            <Loading Message="Commit'ler yukleniyor..." />
        }
        else if (commits.TotalCount == 0)
        {
            <EmptyState Title="Bu suzgeclerle commit yok" Detail="Suzgecleri gevsetip tekrar dene." />
        }
        else
        {
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th scope="col">Commit</th>
                            <th scope="col">Tarih</th>
                            <th scope="col" class="wrap">Mesaj</th>
                            <th scope="col" class="num">+/-</th>
                            <th scope="col" class="num">C# dosyasi</th>
                            <th scope="col">Isaretler</th>
                            <th scope="col"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (CommitListItem commit in commits.Items)
                        {
                            <tr>
                                <td><code>@commit.ShortSha</code></td>
                                <td>@Display.Day(commit.AuthorDateUtc)</td>
                                <td class="wrap">@commit.MessageSubject</td>
                                <td class="num">+@commit.LinesAdded / -@commit.LinesDeleted</td>
                                <td class="num">@commit.CsFilesChanged</td>
                                <td>
                                    @if (commit.IsFix)
                                    {
                                        <span class="pill tone-idle">duzeltme</span>
                                    }
                                    @if (commit.IsBugIntroducing)
                                    {
                                        <span class="pill tone-warning">SZZ</span>
                                    }
                                    @if (commit.IsBot)
                                    {
                                        <span class="pill tone-unknown">bot</span>
                                    }
                                </td>
                                <td><a href="repositories/@RepositoryId/commits/@commit.Sha/risk">Risk</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <Pager Page="commits.Page"
                   PageSize="commits.PageSize"
                   TotalCount="commits.TotalCount"
                   PageChanged="ChangePageAsync"
                   PageSizeChanged="ChangeSizeAsync" />
        }
    </div>
}

@code {
    private readonly CancellationTokenSource closing = new();

    [Parameter]
    public int RepositoryId { get; set; }

    /// <summary>
    /// Butun gorsellestirme secimleri adres cubugunda.
    ///
    /// Boylece bir harita baglantisi paylasilabiliyor, geri/ileri tuslari calisiyor ve
    /// sayfa yenilendiginde ayni sey geliyor.
    /// </summary>
    [SupplyParameterFromQuery(Name = "tab")]
    private string? Tab { get; set; }

    [SupplyParameterFromQuery(Name = "job")]
    private Guid? Job { get; set; }

    [SupplyParameterFromQuery(Name = "window")]
    private int? Window { get; set; }

    [SupplyParameterFromQuery(Name = "limit")]
    private int? Limit { get; set; }

    [SupplyParameterFromQuery(Name = "sort")]
    private string? Sort { get; set; }

    [SupplyParameterFromQuery(Name = "count")]
    private int? Count { get; set; }

    [SupplyParameterFromQuery(Name = "overlay")]
    private Guid? OverlayJob { get; set; }

    private IDisposable? persisting;
    private bool loading = true;
    private IProblemView? failure;
    private RepositoryDetail? detail;
    private List<JobSummary>? jobs;
    private PagedResponse<AnalysisJobResponse>? riskJobs;
    private PagedResponse<AnalysisJobResponse>? scanJobs;
    private PagedResponse<CommitListItem>? commits;

    private string? busy;
    private IProblemView? startProblem;
    private string? conflictUrl;

    private int commitPage = 1;
    private int commitSize = 25;
    private string order = "newest";
    private bool? isFix;
    private bool? isBugIntroducing;
    private bool? isBot;

    /// <summary>
    /// Bu depo ve tur icin su an aktif olan is; yoksa null.
    ///
    /// Dugmeyi kapatan sey bu. API zaten ikinci bir is acmiyor ve <c>409</c> donuyor;
    /// ama kullaniciya reddedilecegi belli olan bir dugme gostermenin anlami yok.
    /// </summary>
    private JobSummary? Active(string kind) =>
        jobs?.FirstOrDefault(job => job.Kind == kind && job.Status is "queued" or "running");

    private IEnumerable<JobSummary> ActiveJobs =>
        jobs?.Where(job => job.Status is "queued" or "running") ?? [];

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;
        failure = null;
        StateHasChanged();

        ApiResult<RepositoryDetail> result = await State.TakeOrFetchAsync(
            DetailKey,
            () => Api.RepositoryAsync(RepositoryId, closing.Token));

        if (!result.IsSuccess)
        {
            (loading, failure) = (false, result);

            return;
        }

        detail = result.Value;
        loading = false;

        // Kucuk projeksiyon: is tablosu resultSummary gostermiyor ve o alan is basina
        // ayri bir JSON blogu. Gostermedigin bayti on-isleme durumunda tasimak, durumu
        // bosuna sisirip devre sinirini zorluyor.
        jobs = (await State.TakeOrFetchAsync(
            JobsKey,
            async () =>
            {
                ApiResult<PagedResponse<AnalysisJobResponse>> page =
                    await Api.AnalysesAsync(RepositoryId, 1, 5, null, null, closing.Token);

                return page.IsSuccess && page.Value is not null
                    ? ApiResult<List<JobSummary>>.Ok([.. page.Value.Items.Select(JobSummary.From)])
                    : ApiResult<List<JobSummary>>.Unreachable(page.Detail ?? "Isler okunamadi.");
            })).Value;

        // Is listeleri yalniz gorsellestirme sekmelerinde kullaniliyor ve o sekmeler
        // etkilesimli asamada calisiyor; on-islemede cekmek bosa istek olurdu.
        if (RendererInfo.IsInteractive)
        {
            // Durum suzgeci YOK: iptal edilmis ama satir yazmis bir is de secilebilmeli.
            // Varsayilan yine tamamlanmis is; kismi olan yalnizca acikca seciliyor.
            riskJobs = (await Api.AnalysesAsync(
                RepositoryId, 1, 50, null, "risk-score-all", closing.Token)).Value;

            scanJobs = (await Api.AnalysesAsync(
                RepositoryId, 1, 50, "succeeded", "static-scan", closing.Token)).Value;
        }

        await LoadCommitsAsync();
    }

    private static readonly (string Key, string Label)[] Tabs =
    [
        ("genel", "Genel"),
        ("dosyalar", "Dosya Etkinligi"),
        ("zaman", "Risk Zaman Cizelgesi"),
        ("commitler", "Commitler"),
        ("analizler", "Analizler"),
        ("rapor", "Rapor"),
    ];

    private string CurrentTab => Tabs.Any(tab => tab.Key == Tab) ? Tab! : "genel";

    /// <summary>Yalnizca sonuc yazmis risk isleri; bos bir is gosterilecek bir sey uretmiyor.</summary>
    private IReadOnlyList<AnalysisJobResponse> RiskJobs =>
        riskJobs?.Items.Where(job => job.ResultCount > 0).ToList() ?? [];

    private IReadOnlyList<AnalysisJobResponse> ScanJobs =>
        scanJobs?.Items.Where(job => job.IsResultComplete).ToList() ?? [];

    /// <summary>
    /// Secili is.
    ///
    /// Varsayilan **tamamlanmis** olan: kismi bir isi kendiliginden secmek, eksik bir
    /// siralamayi sayfanin normal hali gibi gostermek olurdu. Yalniz kismi isler varsa
    /// kullanici acikca secebiliyor.
    /// </summary>
    private Guid? SelectedJob => Job is Guid chosen && RiskJobs.Any(job => job.Id == chosen)
        ? chosen
        : RiskJobs.FirstOrDefault(job => job.IsResultComplete)?.Id;

    private int SelectedWindow =>
        Window is int value && VisualizationLimits.IsWindow(value) ? value : VisualizationLimits.DefaultCommitWindow;

    private int SelectedLimit =>
        Limit is int value && VisualizationLimits.IsFileLimit(value) ? value : VisualizationLimits.DefaultFileLimit;

    private int SelectedCount =>
        Count is int value && VisualizationLimits.IsTimelineCount(value)
            ? value
            : VisualizationLimits.DefaultTimelineCount;

    private string SelectedSort =>
        VisualizationLimits.IsSort(Sort) ? Sort! : FileActivitySort.MeanRiskDescending;

    private Guid? Overlay => OverlayJob is Guid chosen && ScanJobs.Any(job => job.Id == chosen) ? chosen : null;

    /// <summary>Secimleri adres cubuguna yazar; geri/ileri tuslari boylece calisiyor.</summary>
    private void Go(
        string? tab = null,
        Guid? job = null,
        int? window = null,
        int? limit = null,
        string? sort = null,
        int? count = null,
        Guid? overlay = null,
        bool clearOverlay = false)
    {
        Dictionary<string, object?> query = new(StringComparer.Ordinal)
        {
            ["tab"] = tab ?? CurrentTab,
            ["job"] = (job ?? SelectedJob)?.ToString(),
            ["window"] = window ?? SelectedWindow,
            ["limit"] = limit ?? SelectedLimit,
            ["sort"] = sort ?? SelectedSort,
            ["count"] = count ?? SelectedCount,
            ["overlay"] = clearOverlay ? null : (overlay ?? Overlay)?.ToString(),
        };

        Navigation.NavigateTo(Navigation.GetUriWithQueryParameters(query));
    }

    private string DetailKey => PageStateKey.For("repository", ("repo", RepositoryId));

    private string JobsKey => PageStateKey.For("repository", ("repo", RepositoryId), ("part", "jobs"));

    /// <summary>
    /// Commit listesinin anahtari butun suzgecleri iceriyor. Icermeseydi, kullanici
    /// "yalniz duzeltmeler" secip sayfayi yenilediginde on-islemeden kalan suzulmemis
    /// liste gelirdi ve suzgecin calistigini sanardi.
    /// </summary>
    private string CommitsKey => PageStateKey.For(
        "repository",
        ("repo", RepositoryId),
        ("part", "commits"),
        ("page", commitPage),
        ("size", commitSize),
        ("order", order),
        ("fix", isFix),
        ("szz", isBugIntroducing),
        ("bot", isBot));

    private async Task LoadCommitsAsync()
    {
        commits = null;
        StateHasChanged();

        string key = CommitsKey;

        commits = (await State.TakeOrFetchAsync(
            key,
            () => Api.CommitsAsync(
                RepositoryId, commitPage, commitSize, order, isFix, isBugIntroducing, isBot, closing.Token))).Value;

        persisting?.Dispose();
        persisting = new Subscriptions(
            State.Persist(DetailKey, () => detail),
            State.Persist(JobsKey, () => jobs),
            State.Persist(key, () => commits));
    }

    /// <summary>
    /// Isi baslatir.
    ///
    /// Tekrar anahtari **istek basina** burada uretiliyor ve dugme istek boyunca kapali
    /// kaliyor. Ikisi birlikte cift tiklamayi kesiyor: dugme yetismezse bile ayni anahtarla
    /// giden ikinci istek yeni bir is acmiyor.
    /// </summary>
    private async Task StartAsync(string kind)
    {
        busy = kind;
        startProblem = null;
        conflictUrl = null;
        StateHasChanged();

        JobStart start = await Api.StartAsync(RepositoryId, kind, Guid.NewGuid().ToString("n"), closing.Token);

        busy = null;

        switch (start.Outcome)
        {
            case JobStartOutcome.Accepted or JobStartOutcome.AlreadyOpen when start.Job is not null:
                Navigation.NavigateTo($"analyses/{start.Job.Id}");

                return;

            case JobStartOutcome.Conflict:
                conflictUrl = start.ActiveJobUrl;

                break;

            default:
                startProblem = start.Problem is null ? null : ProblemSummary.From(start.Problem);

                break;
        }

        jobs = (await Api.AnalysesAsync(RepositoryId, 1, 5, null, null, closing.Token))
            .Value?.Items.Select(JobSummary.From).ToList();
    }

    /// <summary>API'nin verdigi adresi panelin adresine cevirir.</summary>
    private static string PanelLink(string apiUrl) =>
        "analyses/" + apiUrl.Split('/', StringSplitOptions.RemoveEmptyEntries)[^1];

    private static string Text(bool? value) => value switch
    {
        true => "true",
        false => "false",
        null => string.Empty,
    };

    private static bool? Flag(ChangeEventArgs args) => args.Value?.ToString() switch
    {
        "true" => true,
        "false" => false,
        _ => null,
    };

    private Task Apply(Action change)
    {
        change();
        commitPage = 1;

        return LoadCommitsAsync();
    }

    private Task ChangePageAsync(int value)
    {
        commitPage = value;

        return LoadCommitsAsync();
    }

    private Task ChangeSizeAsync(int value)
    {
        commitSize = value;
        commitPage = 1;

        return LoadCommitsAsync();
    }

    public void Dispose()
    {
        persisting?.Dispose();
        closing.Cancel();
        closing.Dispose();
    }
}
