@*
    Sayfalama.

    Sayfa boyutu secenekleri API'nin ust sinirini (100) asmiyor; asan bir secenek
    koymak, kullaniciya her seferinde hata gosterilmesi demek olurdu.
*@
<div class="row-spread" style="margin-top:var(--space-4)">
    <p class="muted" style="margin:0">
        Toplam @Display.Count(TotalCount) kayit &middot; sayfa @Page / @TotalPages
    </p>

    <div class="row">
        <label class="field">
            Sayfa boyutu
            <select value="@PageSize" @onchange="ChangeSizeAsync" aria-label="Sayfa boyutu">
                @foreach (int size in Sizes)
                {
                    <option value="@size" selected="@(size == PageSize)">@size</option>
                }
            </select>
        </label>

        <button class="btn" type="button" disabled="@(Page <= 1)" @onclick="() => GoAsync(Page - 1)">Onceki</button>
        <button class="btn" type="button" disabled="@(Page >= TotalPages)" @onclick="() => GoAsync(Page + 1)">Sonraki</button>
    </div>
</div>

@code {
    /// <summary>API'nin ust siniri 100; buyuk bir secenek eklenemez.</summary>
    public static readonly int[] Sizes = [25, 50, 100];

    [Parameter, EditorRequired]
    public int Page { get; set; }

    [Parameter, EditorRequired]
    public int PageSize { get; set; }

    [Parameter, EditorRequired]
    public int TotalCount { get; set; }

    [Parameter]
    public EventCallback<int> PageChanged { get; set; }

    [Parameter]
    public EventCallback<int> PageSizeChanged { get; set; }

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(TotalCount / (double)Math.Max(1, PageSize)));

    private Task GoAsync(int page) => PageChanged.InvokeAsync(Math.Clamp(page, 1, TotalPages));

    private Task ChangeSizeAsync(ChangeEventArgs args) =>
        int.TryParse(args.Value?.ToString(), out int size) && Sizes.Contains(size)
            ? PageSizeChanged.InvokeAsync(size)
            : Task.CompletedTask;
}
