      arasinda sessiz bir ayrisma birakirdi.
    -->
    <ProjectReference Include="..\..\tools\Sievert.Demo\Sievert.Demo.csproj" />
    <ProjectReference Include="..\..\src\Sievert.Cli\Sievert.Cli.csproj" />
    <ProjectReference Include="..\..\src\Sievert.Contracts\Sievert.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Sievert.Data\Sievert.Data.csproj" />
    <ProjectReference Include="..\..\src\Sievert.Mining\Sievert.Mining.csproj" />
